# Database — PostgreSQL (Prisma Postgres / Neon / Supabase)
# Example: postgres://USER:PASSWORD@HOST:5432/postgres?sslmode=require
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Admin bootstrap (used by seed script)
ADMIN_EMAIL="admin@jewelry.local"
ADMIN_PASSWORD="ChangeMeAdmin123!"
ADMIN_NAME="Studio Admin"

# Auth — min 32 characters
SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="Maison Atelier"
CURRENCY="USD"
TAX_RATE="0.08"

# Uploads (local: public/uploads — Vercel uses /tmp automatically)
UPLOAD_DIR="public/uploads"
MAX_UPLOAD_MB="10"

# Email (optional — submissions succeed without these)
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
OWNER_EMAIL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
EMAIL_TO_ADMIN=""

# WhatsApp (optional future)
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM=""

# AI 3D generation (local / self-hosted — no paid API required)
# mock = UI development without GPU
# hunyuan = local ai-service wrapping Hunyuan3D-2
AI3D_PROVIDER="mock"
AI3D_API_URL="http://localhost:8080"
AI3D_TIMEOUT="300000"
AI3D_MOCK_DELAY_MS="2500"

# Optional concept image provider (local open-source later)
# mock = local SVG placeholders
# freepik = uses YOUR Freepik API key (add yourself — never commit secrets)
IMAGE_PROVIDER="mock"
IMAGE_PROVIDER_URL=""
FREEPIK_API_KEY=""

# Legacy optional text AI (not required for jewelry generation MVP)
AI_PROVIDER=""
AI_API_KEY=""
AI_MODEL=""
